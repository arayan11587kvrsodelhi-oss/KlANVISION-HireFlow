# HireFlow Backend Environment Configuration
# Copy this file to `.env` and fill in the values.
# Never commit `.env` to version control.

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Neon PostgreSQL connection string (required)
# Format: postgresql://user:password@ep-xyz.neon.tech:5432/dbname
# Get this from the Neon console when you create a project.
NEON_DSN="postgresql://neon_owner:neon_password@ep-project.neon.tech:5432/hrflow"

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Secret key for JWT signing (required - 256-bit minimum)
# Generate with: openssl rand -hex 32
SECRET_KEY="your-256-bit-secret-key-here-minimum-32-characters"

# Bcrypt cost factor for password hashing (8-31, default: 12)
# Higher cost = more secure but slower password operations
BCRYPT_COST=12

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Allowed origins for frontend CORS policy
# Include both http:// and https:// versions for development
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://hireflow.app"

# ==========================================
# ENVIRONMENT
# ==========================================
# Application environment: development, staging, production
ENVIRONMENT="development"

# ==========================================
# RATE LIMITING
# ==========================================
# General rate limit per minute (default: 100)
RATE_LIMIT_PER_MIN=100

# Auth rate limit per minute (default: 5)
RATE_LIMIT_AUTH_PER_MIN=5

# ==========================================
# S3 RESUME STORAGE
# ==========================================
# S3-compatible storage endpoint for resume files
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"

# S3 bucket name for resume storage
S3_BUCKET="hireflow-resumes"

# S3 access key ID (required if using custom S3 provider)
S3_ACCESS_KEY_ID="your-s3-access-key-id"

# S3 secret access key (required if using custom S3 provider)
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# ==========================================
# CSRF CONFIGURATION
# ==========================================
# Name of the CSRF cookie
CSRF_COOKIE_NAME="csrf_token"

# ==========================================
# ADMIN USER (first-run setup)
# ==========================================
# Initial admin email address
ADMIN_EMAIL="admin@hireflow.local"

# Initial admin password (change immediately after first login)
ADMIN_PASSWORD="admin-change-me-immediately"
