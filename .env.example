# HireFlow Environment Configuration
#
# Copy to `.env` and fill in the values. Never commit `.env`.
# This single file configures BOTH the FastAPI backend and the Vite frontend
# (Vite only exposes variables prefixed with VITE_).

# ==========================================
# DATABASE CONFIGURATION (backend)
# ==========================================
# PostgreSQL connection string. The psycopg v3 driver is required, so the
# scheme must be postgresql+psycopg:// (not plain postgresql://).
# Local:  postgresql+psycopg://postgres:postgres@localhost:5432/hireflow
# Neon:   postgresql+psycopg://user:password@ep-xyz.region.aws.neon.tech/hireflow?sslmode=require
NEON_DSN="postgresql+psycopg://postgres:postgres@localhost:5432/hireflow"

# Database used by the pytest suite (a SEPARATE database; it is reset per test).
TEST_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/hireflow_test"

# Connection pool (tune for your Postgres plan / max_connections).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
DB_ECHO=false

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# Secret key for JWT signing. REQUIRED outside development and must be at
# least 32 characters; the app refuses to start in staging/production without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Generate a DIFFERENT value per environment.
SECRET_KEY=""

# Refresh cookie hardening. Secure defaults to true outside development.
REFRESH_COOKIE_NAME="hireflow_refresh"
REFRESH_COOKIE_SAMESITE="lax"   # lax | strict | none (none requires Secure)
# REFRESH_COOKIE_SECURE=true    # set explicitly only if behind a TLS terminator

# JWT issuer claim (keep stable per environment; tokens from another issuer
# are rejected).
JWT_ISSUER="hireflow-api"

# Bcrypt cost factor for password hashing (8-31, default: 12)
# Higher cost = more secure but slower password operations
BCRYPT_COST=12

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Comma-separated list of EXACT frontend origins (scheme + host + port).
# Credentials are enabled for the refresh cookie, so wildcards are rejected.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==========================================
# FRONTEND (Vite) CONFIGURATION
# ==========================================
# Absolute URL of the API, including the version prefix.
# Development: http://localhost:8000/api/v1
# Production:  https://api.your-domain.com/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ==========================================
# ENVIRONMENT
# ==========================================
# Application environment: development, staging, production
ENVIRONMENT="development"

# ==========================================
# RATE LIMITING
# ==========================================
# Request budgets per minute (per client IP).
# NOTE: the limiter is in-process; see DEPLOYMENT.md for multi-instance guidance.
RATE_LIMIT_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=10

# ==========================================
# RESUME STORAGE
# ==========================================
# Directory on the API host where uploaded resumes are written. In production
# point this at a persistent volume (e.g. /var/lib/hireflow/resumes).
RESUME_STORAGE_DIR="var/resumes"
RESUME_MAX_BYTES=10485760   # 10 MB

# Optional S3 settings (reserved; local disk storage is used by default)
S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
S3_BUCKET="hireflow-resumes"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ==========================================
# FIRST ADMINISTRATOR
# ==========================================
# Used only by `python -m app.cli create-admin`. There is no default password
# and no admin is created automatically at startup.
ADMIN_EMAIL="admin@hireflow.local"
ADMIN_PASSWORD=""
